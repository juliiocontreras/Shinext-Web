rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get("role", null) : null;
    }

    function isDirector() {
      return role() == "director";
    }

    function collaboratorPath() {
      return /databases/$(database)/documents/collaborators/$(request.auth.uid);
    }

    function collaboratorExists() {
      return signedIn() && exists(collaboratorPath());
    }

    function collaborator() {
      return get(collaboratorPath()).data;
    }

    function hasGrant(permission) {
      return collaboratorExists()
        && collaborator().get("permissionGrants", []) is list
        && permission in collaborator().get("permissionGrants", []);
    }

    function hasRevoke(permission) {
      return collaboratorExists()
        && collaborator().get("permissionRevokes", []) is list
        && permission in collaborator().get("permissionRevokes", []);
    }

    function permitted(permission, baseAllowed) {
      return signedIn()
        && !hasRevoke(permission)
        && (isDirector() || hasGrant(permission) || baseAllowed);
    }

    function canViewWorkers() {
      return permitted(
        "view_workers",
        role() == "recruitment" || role() == "operations"
      );
    }

    function canReviewApplications() {
      return permitted(
        "review_applications",
        role() == "recruitment"
      );
    }

    function canApproveApplications() {
      return permitted(
        "approve_applications",
        role() == "recruitment"
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDirector());
      allow create, update, delete: if isDirector();
    }

    match /collaborators/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDirector());
      allow create, update, delete: if isDirector();
    }

    match /workers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canViewWorkers());
      allow create, update, delete: if isDirector();
    }

    match /workerApplications/{applicationId} {
      function isOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function validApplicantCreate() {
        return signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == "received"
          && request.resource.data.documentsPending == true
          && request.resource.data.keys().hasOnly([
            "ownerUid",
            "fullName",
            "email",
            "phone",
            "zone",
            "experience",
            "availability",
            "hasOwnSupplies",
            "status",
            "documentsPending",
            "createdAt",
            "updatedAt"
          ]);
      }

      function validOwnerDocumentUpdate() {
        return isOwner()
          && resource.data.status in ["received", "information_pending"]
          && request.resource.data.status == resource.data.status
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "documents",
            "documentsPending",
            "updatedAt"
          ]);
      }

      allow read: if isOwner() || canReviewApplications() || canApproveApplications();
      allow create: if validApplicantCreate();
      allow update: if validOwnerDocumentUpdate();
      allow delete: if isDirector();
    }

    match /auditLog/{entryId} {
      allow read: if permitted("view_audit", false);
      // Audit entries are server-only through Admin SDK / Cloud Functions.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
