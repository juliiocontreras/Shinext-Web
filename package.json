{
  "name": "shinext-web",
  "private": true,
  "scripts": {
    "test": "node --test tests/emulator/*.test.mjs tests/ui/*.test.mjs tests/seo/*.test.mjs tests/e2e/*.test.mjs",
    "test:ui": "node --test tests/ui/*.test.mjs",
    "test:emulator": "node --test tests/emulator/smoke.test.mjs",
    "emulators": "firebase emulators:start --project demo-shinext-local",
    "emulators:exec": "firebase emulators:exec --project demo-shinext-local \"npm test\"",
    "test:integration": "node --test tests/emulator/*.test.mjs tests/e2e/*.test.mjs",
    "emulators:exec:integration": "firebase emulators:exec --project demo-shinext-local \"npm run test:integration\""
  },
  "devDependencies": {
    "firebase-tools": "^14.16.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0"
  }
}
